{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'keine Abhängigkeiten nötig'",
  "buildCommand": "node build/build.mjs && node build/export.mjs",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    { "source": "/pflegedienst-funk", "destination": "/ueber-uns/", "permanent": true },
    { "source": "/under-construction", "destination": "/", "permanent": true },
    { "source": "/author/:path*", "destination": "/ueber-uns/", "permanent": true },
    { "source": "/category/:path*", "destination": "/ratgeber/", "permanent": true },
    { "source": "/tag/:path*", "destination": "/ratgeber/", "permanent": true },
    { "source": "/(sitemap_index|page-sitemap|wp-sitemap).xml", "destination": "/sitemap.xml", "permanent": true }
  ]
}
